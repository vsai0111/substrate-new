# Copy to server/.env and fill in the password. Never commit the real .env.
#
# In production, provide these as real environment variables instead of a file.
PORT=4000

# MySQL connection.
# The database and user must already exist; see the README for the SQL.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=substrate_app
DB_PASSWORD=
DB_NAME=substrate_db

# Origins allowed to call the API from a browser.
# Production is same-origin through a reverse proxy, so this only matters when
# running the Vite dev server against a remote or local API.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
